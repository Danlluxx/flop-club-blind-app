TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
BRIDGE_COMMAND_TOKEN=
PORT=5175

# API приложения flop-club-tg, например http://localhost:4000
FLOP_CLUB_TG_API_URL=
FLOP_CLUB_TG_PARTICIPANTS_URL=

# JWT админа из flop-club-tg. Используется только сервером таймера.
FLOP_CLUB_TG_TOKEN=

# Для локального запуска можно не указывать JWT: таймер сам получит dev-admin токен.
# Работает только когда flop-club-tg запущен в NODE_ENV=development.
FLOP_CLUB_TG_DEV_AUTH=true

# Опционально: id турнира из flop-club-tg.
# Если не указать, таймер сам выберет ближайший открытый турнир за текущий день.
FLOP_CLUB_TG_TOURNAMENT_ID=

# Как часто сервер таймера обновляет участников из flop-club-tg.
PARTICIPANTS_CACHE_MS=10000
